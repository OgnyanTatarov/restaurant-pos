{
  "name": "restaurant-pos",
  "version": "1.2.0",
  "private": true,
  "description": "Local-first restaurant POS for Windows, Android and iOS",
  "author": "Restaurant POS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.mjs",
    "hub": "node desktop/standalone.mjs",
    "mobile:sync": "npm run build && cap sync",
    "android": "npm run mobile:sync && cap open android",
    "ios": "npm run mobile:sync && cap open ios",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:win:publish": "npm run build && electron-builder --win nsis --publish always",
    "release": "npm test && git tag \"v$npm_package_version\" && git push origin HEAD && git push origin \"v$npm_package_version\"",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.restaurant.pos",
    "productName": "Restaurant POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "core/**/*",
      "package.json"
    ],
    "artifactName": "Restaurant-POS-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "OgnyanTatarov",
      "repo": "restaurant-pos",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
